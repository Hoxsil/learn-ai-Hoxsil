   ],
   "source": [
    "x = np.array([1, 2, 3, 4, 5])\n",
    "figure, axes = plt.subplots(2, 2)\n",
    "\n",
    "axes[0, 0].plot(x, x**2)\n",
    "axes[0, 0].set_title(\"x^2\")\n",
    "\n",
    "axes[0, 1].bar(x, x**3)\n",
    "axes[0, 1].set_title(\"x^3\")\n",
    "\n",
    "plt.show()"
   ]
  }
